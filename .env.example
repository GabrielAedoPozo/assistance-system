# MySQL. Puede ser una base nueva dentro de tu MySQL actual de Railway (ver README).
# En Railway, si la app y MySQL están en el mismo proyecto, usa la URL interna (mysql.railway.internal).
DATABASE_URL=mysql://asistencias:CLAVE@HOST:3306/asistencias

# Contraseña del panel /admin (mínimo 8 caracteres)
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión del admin (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Nombre que aparece en la pantalla y en los Excel
EMPRESA_NOMBRE=Mi Empresa S.A.C.
